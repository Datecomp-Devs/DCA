<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Modo claro: el fondo de ventana debe coincidir con la superficie del
         esquema claro de Compose (blanco). Fondo negro fijo hacía que los
         textos oscuros del esquema claro quedaran ilegibles. -->
    <style name="Theme.DCA" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:colorAccent">@color/black</item>
    </style>
</resources>